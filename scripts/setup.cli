embed-server --server-config=standalone.xml

/subsystem=ejb3/service=timer-service/database-data-store=ejb_timer_ds:add(datasource-jndi-name="java:jboss/datasources/jBPMDS",database="jbpm",partition="ejb_timer_master_part",refresh-interval="30000")

/subsystem=ejb3/service=timer-service:write-attribute(name="default-data-store", value="ejb_timer_ds")

/subsystem=microprofile-opentracing-smallrye:remove()

/extension=org.wildfly.extension.microprofile.opentracing-smallrye:remove()

/subsystem=messaging-activemq/server=default/queue=PROCESS_MESSAGES.Q:add(durable=true,queue-address=PROCESS_MESSAGES.Q)

stop-embedded-server